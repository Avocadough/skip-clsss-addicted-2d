; Engine configuration file.
; Skip Class Addicted - เสพติดการโดดเรียน!

config_version=5

[application]

config/name="Skip Class Addicted"
config/description="เสพติดการโดดเรียน! - 2D Pixel Art Stealth-Puzzle Platformer"
config/version="1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.101961, 0.0862745, 0.141176, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game_state.gd"
Sfx="*res://scripts/audio_manager.gd"
Fader="*res://scripts/fader.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

